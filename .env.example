# 复制为 .env 并填写实际值（.env 不提交到 git）

# 必填：JWT 签名密钥，缺失时后端拒绝启动。
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 可选：首次 seed 时的初始管理员密码（未设置则随机生成并打印到日志）
#INITIAL_ADMIN_PASSWORD=

# 可选：首次 seed 时其他默认账号的初始密码（未设置则随机生成）
#INITIAL_USER_PASSWORD=

# 可选：数据目录（留空 = 本地 ./data；服务器上指向 NAS）
#DATA_DIR=

# 可选：CORS 允许来源（逗号分隔），未设置时默认仅本地开发端口
#CORS_ORIGINS=http://localhost:5000,http://localhost:5173

# 可选：钉钉告警 webhook（watchdog 告警用）
#DINGTALK_WEBHOOK_URL=
